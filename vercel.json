{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/flow-proxy/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/flow-proxy",
      "dest": "/server.js"
    },
    {
      "src": "/fx/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/_next/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
