{
  "manifest_version": 3,
  "name": "AffiliateGo - Google Flow Auto Session Injector",
  "version": "1.0.2",
  "description": "Auto injects active VIP Google Flow sessions for AffiliateGo creators.",
  "permissions": [
    "cookies",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://labs.google/*",
    "*://*.google.com/*",
    "*://*.vercel.app/*",
    "*://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://affiliatego.vercel.app/*",
        "https://*.vercel.app/*",
        "http://localhost:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AffiliateGo Flow Injector"
  },
  "background": {
    "service_worker": "background.js"
  }
}
